{
  "$schema": "https://mintlify.com/docs.json",
  "name": "TailAdmin",
  "theme": "willow",
  "colors": {
    "primary": "#141c2b",
    "light": "#4257e2",
    "dark": "#9cacec"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "https://media.brand.dev/b7bf0b41-34b4-40e9-a402-5c01401df9d0.svg",
    "dark": "https://media.brand.dev/b7bf0b41-34b4-40e9-a402-5c01401df9d0.svg"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/TailAdmin/free-nextjs-admin-dashboard"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/TailAdmin/free-nextjs-admin-dashboard"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Getting Started",
        "groups": [
          {
            "group": "Introduction",
            "pages": ["introduction", "getting-started/installation", "getting-started/project-structure"]
          },
          {
            "group": "Configuration",
            "pages": ["getting-started/tailwind-config", "getting-started/dark-mode", "getting-started/typescript"]
          }
        ]
      },
      {
        "tab": "Components",
        "groups": [
          {
            "group": "Layout",
            "pages": ["components/sidebar", "components/header", "components/dashboard-layout"]
          },
          {
            "group": "UI Elements",
            "pages": [
              "components/buttons",
              "components/alerts",
              "components/badges",
              "components/modals",
              "components/dropdowns",
              "components/avatars",
              "components/images",
              "components/videos"
            ]
          },
          {
            "group": "Data Display",
            "pages": ["components/tables", "components/charts-line", "components/charts-bar"]
          },
          {
            "group": "Forms",
            "pages": [
              "components/form-elements",
              "components/date-picker",
              "components/multi-select",
              "components/select"
            ]
          }
        ]
      },
      {
        "tab": "Pages",
        "groups": [
          {
            "group": "Dashboard",
            "pages": ["pages/ecommerce-dashboard"]
          },
          {
            "group": "Authentication",
            "pages": ["pages/sign-in", "pages/sign-up"]
          },
          {
            "group": "Other Pages",
            "pages": ["pages/profile", "pages/calendar", "pages/blank-page", "pages/404"]
          }
        ]
      },
      {
        "tab": "Customization",
        "groups": [
          {
            "group": "Theming",
            "pages": ["customization/colors", "customization/typography", "customization/layouts"]
          },
          {
            "group": "Upgrade",
            "pages": ["customization/pro-version", "customization/changelog"]
          }
        ]
      }
    ]
  }
}
