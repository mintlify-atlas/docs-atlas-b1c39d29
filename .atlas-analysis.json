{
  "projectType": "frontend",
  "projectName": "TailAdmin",
  "projectDescription": "A free, open-source Next.js and Tailwind CSS admin dashboard template with 30+ components, data visualization, authentication pages, and UI elements for building feature-rich back-end and admin panel applications.",
  "theme": "willow",
  "primaryColor": "#141c2b",
  "lightColor": "#4257e2",
  "darkColor": "#9cacec",
