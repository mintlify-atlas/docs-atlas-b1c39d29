  "keyFeatures": [
    "Ecommerce dashboard with metrics, sales charts, and order tables",
    "Dark mode support with Tailwind CSS",
    "Collapsible sidebar navigation",
    "ApexCharts integration (line and bar charts)",
    "Interactive calendar with FullCalendar",
    "Authentication pages (Sign In, Sign Up)",
    "30+ reusable UI components (buttons, modals, alerts, badges, dropdowns)",
    "Form elements with date picker, multi-select, and file upload",
    "Responsive layout with Next.js App Router",
    "TypeScript support throughout",
    "World map demographic visualization with jVectorMap",
    "Drag-and-drop file upload with react-dropzone"
  ],
  "publicApiSurface": [
    "Button component (variant: primary | outline, size: sm | md)",
    "Alert component (with variant and icon support)",
    "Modal component (useModal hook)",
    "Dropdown component",
    "Badge component",
    "Avatar component",
    "Table component",
    "LineChart component (ApexCharts wrapper)",
    "BarChart component (ApexCharts wrapper)",
    "EcommerceMetrics component",
    "MonthlySalesChart component",
    "MonthlyTarget component",
    "StatisticsChart component",
    "RecentOrders component",
    "DemographicCard component",
    "CountryMap component (jVectorMap)",
    "AppSidebar layout component",
    "AppHeader layout component",
    "SignInForm component",
    "SignUpForm component",
    "DatePicker form component (flatpickr)",
    "MultiSelect form component",
    "Select form component",
    "useModal hook",
    "useGoBack hook"
  ]
}
